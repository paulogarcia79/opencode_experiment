# Backend
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/blog
ADMIN_API_TOKEN=dev-token-change-in-production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin
JWT_SECRET_KEY=super-secret-key-change-in-production

# Email (Resend) — leave empty to skip sending emails
RESEND_API_KEY=
RESEND_FROM_EMAIL=newsletter@example.com

# Frontend
APP_BASE_URL=http://localhost
# Leave empty when running behind Nginx proxy (uses relative /api paths)
VITE_API_BASE_URL=
