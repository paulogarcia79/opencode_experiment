{"nodes": [{"id": "design", "label": "Platform Design Document", "file_type": "document", "source_file": "openspec/changes/archive/2025-05-06-blog-newsletter-platform/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_tiptap_json_storage", "label": "TipTap JSON Content Storage", "file_type": "rationale", "source_file": "openspec/changes/archive/2025-05-06-blog-newsletter-platform/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Store article content as TipTap JSON document (text column), render HTML on-the-fly for public view and newsletters. Source of truth for both web and email rendering. TipTap is headless, giving full control over the lab aesthetic. Adding a cached HTML column later is trivial if needed."}, {"id": "design_resend_synchronous", "label": "Resend Synchronous Email Delivery", "file_type": "rationale", "source_file": "openspec/changes/archive/2025-05-06-blog-newsletter-platform/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use Resend API with synchronous calls from the publish endpoint. Resend has a modern Python SDK and generous free tier. Synchronous delivery avoids adding Redis/Celery infrastructure for MVP scale (< 1,000 subscribers). If scale exceeds this, adding a background queue later requires no schema changes."}, {"id": "design_bearer_token_auth", "label": "Bearer Token Authentication", "file_type": "rationale", "source_file": "openspec/changes/archive/2025-05-06-blog-newsletter-platform/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Protect admin routes with a single ADMIN_API_TOKEN env variable checked via FastAPI dependency. Zero login UI, zero session storage, trivial to rotate. The User table exists from day one to avoid a painful migration when real auth is added later."}, {"id": "design_double_opt_in_soft_unsubscribe", "label": "Double Opt-in and Soft Unsubscribe", "file_type": "rationale", "source_file": "openspec/changes/archive/2025-05-06-blog-newsletter-platform/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pending -> active via confirmation email link. Unsubscribe sets unsubscribed status (soft delete). Double opt-in keeps list quality high and avoids spam complaints that hurt Resend deliverability. Soft unsubscribe preserves history and is legally required in most jurisdictions."}, {"id": "design_human_readable_slugs", "label": "Human-Readable Slugs", "file_type": "rationale", "source_file": "openspec/changes/archive/2025-05-06-blog-newsletter-platform/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "URLs use /<slug> format derived from title with uniqueness constraint and -N collision suffix. Standard blog behavior, SEO-friendly, and expected by readers."}, {"id": "design_external_urls_only", "label": "External URLs Only for Images", "file_type": "rationale", "source_file": "openspec/changes/archive/2025-05-06-blog-newsletter-platform/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TipTap image node accepts external URLs only. No upload endpoint in MVP. Keeps MVP lean while still allowing rich articles. Upload can be added later without schema changes since src just changes from external to internal URL."}], "edges": [{"source": "design_tiptap_json_storage", "target": "spec_article_management", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "openspec/changes/archive/2025-05-06-blog-newsletter-platform/design.md", "source_location": null, "weight": 1.0}, {"source": "design_resend_synchronous", "target": "spec_newsletter_delivery", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "openspec/changes/archive/2025-05-06-blog-newsletter-platform/design.md", "source_location": null, "weight": 1.0}, {"source": "design_bearer_token_auth", "target": "spec_admin_authentication", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "openspec/changes/archive/2025-05-06-blog-newsletter-platform/design.md", "source_location": null, "weight": 1.0}, {"source": "design_double_opt_in_soft_unsubscribe", "target": "spec_subscriber_management", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "openspec/changes/archive/2025-05-06-blog-newsletter-platform/design.md", "source_location": null, "weight": 1.0}, {"source": "design_human_readable_slugs", "target": "spec_article_management", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "openspec/changes/archive/2025-05-06-blog-newsletter-platform/design.md", "source_location": null, "weight": 1.0}, {"source": "design", "target": "tasks", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "openspec/changes/archive/2025-05-06-blog-newsletter-platform/design.md", "source_location": null, "weight": 1.0}, {"source": "design_tiptap_json_storage", "target": "proposal", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "openspec/changes/archive/2025-05-06-blog-newsletter-platform/design.md", "source_location": null, "weight": 1.0}, {"source": "design_resend_synchronous", "target": "proposal", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "openspec/changes/archive/2025-05-06-blog-newsletter-platform/design.md", "source_location": null, "weight": 1.0}, {"source": "design_bearer_token_auth", "target": "proposal", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "openspec/changes/archive/2025-05-06-blog-newsletter-platform/design.md", "source_location": null, "weight": 1.0}, {"source": "design_double_opt_in_soft_unsubscribe", "target": "proposal", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "openspec/changes/archive/2025-05-06-blog-newsletter-platform/design.md", "source_location": null, "weight": 1.0}, {"source": "design_human_readable_slugs", "target": "proposal", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "openspec/changes/archive/2025-05-06-blog-newsletter-platform/design.md", "source_location": null, "weight": 1.0}], "hyperedges": []}