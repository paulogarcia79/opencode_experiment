{% extends "base.mjml" %}

{% block content %}
<mj-text font-size="28px" font-weight="bold" padding-bottom="20px" color="#7C3AED" css-class="brand-title">
  Verify Your Email Address
</mj-text>
<mj-text>
  Welcome to <strong>{{ site_name }}</strong>! Click the button below to verify your email address and activate your account.
</mj-text>
<mj-button href="{{ verification_url }}" border-radius="12px" padding-top="30px" inner-padding="16px 32px" font-size="18px">
  VERIFY EMAIL
</mj-button>
<mj-text font-size="14px" color="#94a3b8" padding-top="40px" align="center">
  This link will expire in 24 hours. If you didn't create an account, you can safely ignore this email.
</mj-text>
{% endblock %}
