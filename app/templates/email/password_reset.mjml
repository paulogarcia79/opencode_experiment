{% extends "base.mjml" %}

{% block content %}
<mj-text font-size="28px" font-weight="bold" padding-bottom="20px" color="#7C3AED" css-class="brand-title">
  Password Reset Requested
</mj-text>
<mj-text>
  Someone requested a password reset for your <strong>{{ site_name }}</strong> account. If this was you, click the button below to set a new password.
</mj-text>
<mj-button href="{{ reset_url }}" border-radius="12px" padding-top="30px" inner-padding="16px 32px" font-size="18px">
  RESET PASSWORD
</mj-button>
<mj-text font-size="14px" color="#94a3b8" padding-top="40px" align="center">
  This link will expire in 15 minutes. If you didn't request this, you can safely ignore this email.
</mj-text>
{% endblock %}
